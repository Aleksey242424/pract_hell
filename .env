# Подключение к твоей базе PostgreSQL (замени user, password и dbname на свои)
DATABASE_URL=postgresql://postgres:123@localhost:5432/my_db

# Секретный ключ для JWT (можешь сгенерировать любой длинный набор символов)
JWT_SECRET_KEY=super_secret_key_for_educational_practice_2026_change_me
JWT_ALGORITHM=HS256

# Время жизни токена в минутах
ACCESS_TOKEN_EXPIRE_MINUTES=30